NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/webhook_platform
JWT_SECRET=replace-with-at-least-32-random-bytes
REDIS_URL=redis://127.0.0.1:6379

# Set to the exact number of trusted reverse-proxy hops in production.
# The proxy must overwrite forwarded headers; leave at 0 when directly exposed.
TRUST_PROXY_HOPS=0
